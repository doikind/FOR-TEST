# FinSignal Content Agent — environment configuration
# Copy to .env and fill in optional values. All keys are OPTIONAL:
# without any API key the app runs in Demo mode (cached/template AI output).

# --- Optional AI generation (OpenAI-compatible) ---
# Leave empty to run in Demo mode (cached/template output, clearly labeled).
OPENAI_API_KEY=
# OpenAI-compatible base URL (e.g. https://api.openai.com/v1 or DeepSeek endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name used by the OpenAI-compatible adapter
OPENAI_MODEL=gpt-4o-mini

# --- Tuning (optional, sensible defaults used when empty) ---
# Dedup / similarity cosine threshold for event dedup (0..1)
DEDUP_THRESHOLD=0.82
# Similarity threshold for plagiarism risk check (0..1)
SIMILARITY_THRESHOLD=0.85

# --- Data source toggles (optional) ---
# 1 = enabled, 0 = disabled
SOURCE_GOOGLE_NEWS=1
SOURCE_GDELT=1
SOURCE_HACKER_NEWS=1
# CoinGecko is an optional supplement (P1); default off.
SOURCE_COINGECKO=0
